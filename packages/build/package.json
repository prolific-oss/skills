{
  "name": "@prolific/skills-build",
  "version": "1.0.0",
  "description": "Build tooling for Prolific skills - compiles rules into AGENTS.md",
  "type": "module",
  "scripts": {
    "build": "tsx src/build.ts --all",
    "build-study": "tsx src/build.ts --skill=create-and-publish-study",
    "build-messages": "tsx src/build.ts --skill=examine-participant-messages",
    "validate": "tsx src/validate.ts",
    "dev": "pnpm build && pnpm validate"
  },
  "license": "CC0-1.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
