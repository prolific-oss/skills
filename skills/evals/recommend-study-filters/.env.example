# Langfuse OTel endpoint — receives tool-call and model-completion spans from
# the Claude Agent SDK via LangSmith's OTel pipeline.
# For Langfuse Cloud: https://cloud.langfuse.com/api/public/otel
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# OTel auth — base64 encode "pk-lf-...:sk-lf-..." and set as Bearer token
# e.g.  echo -n "pk-lf-...:sk-lf-..." | base64
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <base64-encoded-public:secret>
