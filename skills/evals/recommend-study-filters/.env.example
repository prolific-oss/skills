# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Prolific — use TEST_TOKEN to avoid hitting your personal account during evals
PROLIFIC_TEST_TOKEN=...
# PROLIFIC_TOKEN=...  # fallback if TEST_TOKEN is not set

# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: attribute eval traces to your Langfuse user_id
# LANGFUSE_USER_ID=

# LangSmith OTel (used to parent agent subprocess traces into the dataset run)
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<your-langsmith-api-key>
